class Person:
    def __init__(self,name,age,contact):  
         self.__name=name
         self.__age=0
         self.__contact=""
         self.set_age(age)   #use setters inside constructors to apply validation automatically.
         self.set_contact(contact)
    

    def set_name(self,newname):
        self.__name=newname
    
    def get_name(self):
        return self.__name


    def set_age(self,age):
        if age <5 or age>100:    # local variable 
            print(f"Invalid Age ")
        
        else:
          self.__age=age
    
    def get_age(self):
        return self.__age
    
    def set_contact(self,contact):
        if len(contact) !=11:
            print(f"Invalid Number")
        
        else:
            self.__contact=contact
    
    def get_contact(self):
        return self.__contact

    def display_info(self):
        print(f"Name {self.get_name()} Age is {self.get_age()} and contact is {self.get_contact()}")


